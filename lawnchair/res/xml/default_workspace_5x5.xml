<!--
  One UI style first run layout.

  Row 0 is intentionally left empty: that band is reserved for the One UI
  clock/weather block (see docs/refactor/ARCHITECTURE.md, milestone 1).

  Every entry is a <resolve> with an intent fallback so that devices without
  a given app simply skip the cell instead of failing the whole layout.
-->
<favorites xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher3">

    <!-- Hotseat: dialer, messages, browser, camera, gallery -->
    <resolve launcher:container="-101" launcher:screen="0" launcher:x="0" launcher:y="0">
        <favorite launcher:uri="#Intent;action=android.intent.action.DIAL;end" />
        <favorite launcher:uri="#Intent;action=android.intent.action.CALL_BUTTON;end" />
    </resolve>

    <resolve launcher:container="-101" launcher:screen="0" launcher:x="1" launcher:y="0">
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_MESSAGING;end" />
        <favorite launcher:uri="sms:" />
    </resolve>

    <resolve launcher:container="-101" launcher:screen="0" launcher:x="2" launcher:y="0">
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_BROWSER;end" />
    </resolve>

    <resolve launcher:container="-101" launcher:screen="0" launcher:x="3" launcher:y="0">
        <favorite launcher:uri="#Intent;action=android.media.action.STILL_IMAGE_CAMERA;end" />
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.LAUNCHER;package=com.android.camera2;end" />
    </resolve>

    <resolve launcher:container="-101" launcher:screen="0" launcher:x="4" launcher:y="0">
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_GALLERY;end" />
    </resolve>

    <!-- First icon row -->
    <resolve launcher:screen="0" launcher:x="0" launcher:y="1">
        <favorite launcher:uri="#Intent;action=android.settings.SETTINGS;end" />
    </resolve>

    <resolve launcher:screen="0" launcher:x="1" launcher:y="1">
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.LAUNCHER;package=com.android.deskclock;end" />
        <favorite launcher:uri="#Intent;action=android.intent.action.SHOW_ALARMS;end" />
    </resolve>

    <resolve launcher:screen="0" launcher:x="2" launcher:y="1">
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_CALENDAR;end" />
    </resolve>

    <resolve launcher:screen="0" launcher:x="3" launcher:y="1">
        <favorite launcher:packageName="com.android.documentsui" launcher:className="com.android.documentsui.LauncherActivity" />
        <favorite launcher:uri="#Intent;action=android.intent.action.VIEW;type=resource/folder;end" />
    </resolve>

    <resolve launcher:screen="0" launcher:x="4" launcher:y="1">
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_CONTACTS;end" />
    </resolve>

</favorites>
